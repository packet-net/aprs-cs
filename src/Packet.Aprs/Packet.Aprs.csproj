<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <PackageId>Packet.Aprs</PackageId>
    <GenerateDocumentationFile>true</GenerateDocumentationFile>
    <Title>Packet.Aprs - APRS packet encoder and decoder</Title>
    <Description>APRS (Automatic Packet Reporting System) packet codec per APRS12c: encode and decode every APRS 1.2 data type (positions, compressed and Mic-E, objects, items, weather, telemetry, messages, status, and the rest) from AX.25 frames or TNC2 / APRS-IS text. Spec-strict with Strict / Lenient parse-option presets and a named flag for each real-world deviation. Source: github.com/packet-net/aprs-cs.</Description>
    <PackageTags>aprs;ax25;aprs-is;mic-e;amateur-radio;packet-radio;codec</PackageTags>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="Packet.Core" />
  </ItemGroup>

  <ItemGroup>
    <!-- Snapshot of aprsorg/aprs-deviceid (CC BY-SA 2.0); refresh with scripts/update-aprs-deviceid.py. -->
    <EmbeddedResource Include="Data/aprs-deviceid.json" LogicalName="Packet.Aprs.Data.aprs-deviceid.json" />
    <None Include="THIRD-PARTY-NOTICES.md" Pack="true" PackagePath="\" />
  </ItemGroup>

  <ItemGroup>
    <InternalsVisibleTo Include="Packet.Aprs.Tests" />
    <!-- The corpus tool compiles the vectors' neutral-form reader from the test project, which
         builds out-of-range timestamps as the decoder keeps them. -->
    <InternalsVisibleTo Include="aprs-corpus" />
  </ItemGroup>

</Project>
